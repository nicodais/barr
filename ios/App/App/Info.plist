<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
        <string>Shamal</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!--
	  Tilt steering is one of the three touch control schemes, and iOS 13+ will
	  not even show the permission prompt without this string. TouchSource
	  already asks for the permission from a user gesture; this is the other
	  half, and without it tilt silently does nothing.
	-->
	<key>NSMotionUsageDescription</key>
	<string>Tilt steering uses the motion sensor to read how you are holding the device. Only used if you pick the tilt control scheme.</string>
	<!--
	  No encryption of any kind, and no network use at all — the game never
	  makes a request. Declaring it here means the export-compliance question is
	  answered once instead of on every single build upload.
	-->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!--
	  Status bar off, and off from the plist rather than from JavaScript.
	  Hiding it after the webview has loaded means the clock and the battery are
	  visible over the launch screen and the first frame, then jump away — the
	  plist route never shows it at all.
	-->
	<key>UIStatusBarHidden</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
    <false/>
    <key>UISceneConfigurations</key>
    <dict>
      <key>UIWindowSceneSessionRoleApplication</key>
      <array>
        <dict>
            <key>UISceneConfigurationName</key>
            <string>Default Configuration</string>
            <key>UISceneDelegateClassName</key>
            <string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
            <key>UISceneStoryboardFile</key>
            <string>Main</string>
        </dict>
      </array>
    </dict>
	</dict>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<!--
	  arm64, not the template's armv7. Nothing that can run a 64-bit-only iOS
	  has been 32-bit since the iPhone 5s, and stating a capability the binary
	  does not actually contain is the kind of thing that reads as sloppy in
	  review even when it passes.
	-->
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!--
	  False so UIStatusBarHidden above actually applies. Left true, the hosting
	  view controller decides instead and the app-level setting is ignored.
	-->
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
</dict>
</plist>
